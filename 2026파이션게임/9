    def add_log(self, message):
        self.log_text.config(state="normal")
        self.log_text.insert("end", message + "\n")
        self.log_text.see("end")
        self.log_text.config(state="disabled")

    def load_boss(self, idx):
        boss = self.bosses[idx]
        if idx == 12:
            # 13번째 보스는 주인공 공격력의 13배에 비례하는 체력과 실력을 가짐
            self.boss_max_hp = self.player_power * 13 * 12
            desc = (
                "나는 너의 모습, 그리고 너보다 13배 강한"
                f" 힘({self.player_power * 13:,})을 가졌다!"
            )
        else:
            self.boss_max_hp = boss["hp"]
            desc = boss["desc"]


